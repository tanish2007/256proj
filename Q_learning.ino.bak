#include <Arduino.h>
#include <Preferences.h>
#include "q_table.h"  // Q_TABLE_INIT — pre-trained values from qsim.py

// --- PIN DEFINITIONS (from HardwareCar.ino) ---
// Sensor 1 (Front)
const int trig1 = 5;
const int echo1 = 16;
// Sensor 2 (Left)
const int trig2 = 4;
const int echo2 = 18;
// Sensor 3 (Right)
const int trig3 = 32;
const int echo3 = 26;
// Sensor 4 (Back)
const int trig4 = 19;
const int echo4 = 23;

// Motor Driver Pins (L298N)
const int enA = 15;
const int in1 = 13;
const int in2 = 12;
const int enB = 33;
const int in3 = 14;
const int in4 = 27;

// --- Q-LEARNING PARAMETERS ---
const int NUM_STATES = 16;  // 2^4 sensors (F, L, R, B)
const int NUM_ACTIONS = 4;  // 0:Fwd, 1:Bwd, 2:Left, 3:Right
float q_table[NUM_STATES][NUM_ACTIONS];

float alpha = 0.1;        // Learning rate
float gamma_ = 0.9;       // Discount factor (gamma is reserved on some toolchains)
float epsilon = 0.9;      // Exploration rate (starts high, decays over time)
const float EPS_MIN   = 0.05;
const float EPS_DECAY = 0.999;  // multiplied each step

// Stuck detection: if state doesn't change for this many steps, penalize
const int STUCK_THRESHOLD = 5;     // detect spinning sooner
const float STUCK_PENALTY = 50.0;  // punish spinning more heavily
int lastState = -1;
int sameStateCount = 0;

// State bit layout: bit0=Front, bit1=Left, bit2=Right, bit3=Back
const int BIT_FRONT = 0;
const int BIT_LEFT  = 1;
const int BIT_RIGHT = 2;
const int BIT_BACK  = 3;

const int NEAR_CM = 15;
const int MAX_DIST_CM = 200;

int currentState = 0;

// --- Persistence ---
Preferences prefs;
const char* PREFS_NS  = "qlearn";
const char* PREFS_KEY = "qtable";
const int SAVE_EVERY_N_STEPS = 25;
unsigned long stepCount = 0;

void setup() {
  Serial.begin(115200);

  // Sensors
  pinMode(trig1, OUTPUT); pinMode(echo1, INPUT);
  pinMode(trig2, OUTPUT); pinMode(echo2, INPUT);
  pinMode(trig3, OUTPUT); pinMode(echo3, INPUT);
  pinMode(trig4, OUTPUT); pinMode(echo4, INPUT);

  // Motors
  pinMode(enA, OUTPUT); pinMode(in1, OUTPUT); pinMode(in2, OUTPUT);
  pinMode(enB, OUTPUT); pinMode(in3, OUTPUT); pinMode(in4, OUTPUT);
  analogWrite(enA, 255);
  analogWrite(enB, 255);

  // Load Q-table from flash, or seed from pre-trained Q_TABLE_INIT if missing
  prefs.begin(PREFS_NS, false);
  size_t expected = sizeof(q_table);
  size_t got = prefs.getBytes(PREFS_KEY, q_table, expected);
  if (got != expected) {
    Serial.println("No saved Q-table found, seeding from sim-trained Q_TABLE_INIT.");
    memcpy(q_table, Q_TABLE_INIT, sizeof(q_table));
    prefs.putBytes(PREFS_KEY, q_table, expected);
  } else {
    Serial.println("Loaded Q-table from flash.");
  }
}

void loop() {
  // 1. Observe current state
  currentState = get_encoded_state();

  // 2. Choose action (epsilon-greedy)
  int action;
  if ((random(0, 100) / 100.0) < epsilon) {
    action = random(0, NUM_ACTIONS);
  } else {
    action = get_best_action(currentState);
  }

  // 3. Perform action
  execute_action(action);
  delay(200);
  stop_motors();

  // 4. Observe new state and reward
  int nextState = get_encoded_state();

  // Track stuck-ness (state hasn't changed)
  if (nextState == lastState) sameStateCount++;
  else sameStateCount = 0;
  lastState = nextState;

  float reward = calculate_reward(action, nextState);
  if (sameStateCount >= STUCK_THRESHOLD) reward -= STUCK_PENALTY;

  // 5. Update Q-table (Bellman)
  float maxNextQ = q_table[nextState][get_best_action(nextState)];
  q_table[currentState][action] +=
      alpha * (reward + (gamma_ * maxNextQ) - q_table[currentState][action]);

  // 6. Decay epsilon
  if (epsilon > EPS_MIN) epsilon *= EPS_DECAY;

  Serial.print("State: "); Serial.print(currentState);
  Serial.print(" | Action: "); Serial.print(action);
  Serial.print(" | Reward: "); Serial.print(reward);
  Serial.print(" | Next: "); Serial.print(nextState);
  Serial.print(" | Eps: "); Serial.println(epsilon, 3);

  // 7. Persist periodically
  stepCount++;
  if (stepCount % SAVE_EVERY_N_STEPS == 0) {
    prefs.putBytes(PREFS_KEY, q_table, sizeof(q_table));
    Serial.println("Q-table saved.");
  }
}

// --- HELPERS ---

int readDistance(int trig, int echo) {
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig, LOW);
  long duration = pulseIn(echo, HIGH, 30000);
  int distance = duration * 0.0343 / 2;
  return distance;
}

int get_encoded_state() {
  int dF = readDistance(trig1, echo1);
  int dL = readDistance(trig2, echo2);
  int dR = readDistance(trig3, echo3);
  int dB = readDistance(trig4, echo4);

  int state = 0;
  if (dF > 0 && dF < NEAR_CM) state |= (1 << BIT_FRONT);
  if (dL > 0 && dL < NEAR_CM) state |= (1 << BIT_LEFT);
  if (dR > 0 && dR < NEAR_CM) state |= (1 << BIT_RIGHT);
  if (dB > 0 && dB < NEAR_CM) state |= (1 << BIT_BACK);
  return state;
}

int get_best_action(int state) {
  int best = 0;
  for (int i = 1; i < NUM_ACTIONS; i++) {
    if (q_table[state][i] > q_table[state][best]) best = i;
  }
  return best;
}

float calculate_reward(int action, int nextState) {
  bool frontNear = nextState & (1 << BIT_FRONT);
  bool backNear  = nextState & (1 << BIT_BACK);

  if (action == 0 && frontNear)  return -5;   // mild warning
  if (action == 1 && backNear)   return -5;
  if (action == 0 && !frontNear) return 20;   // reward forward motion
  return -2;                                   // turning costs a bit more
}

// --- MOTOR CONTROL (ported from HardwareCar.ino) ---

void execute_action(int action) {
  switch (action) {
    case 0: moveForward();  break;
    case 1: moveBackward(); break;
    case 2: turnLeft();     break;
    case 3: turnRight();    break;
  }
}

void moveForward() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void moveBackward() {
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void turnRight() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}

void turnLeft() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void stop_motors() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}
